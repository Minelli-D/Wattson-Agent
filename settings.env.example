# The settings of wattson on Kubernetes. No secret is in this file: the three tokens are made
# by k8s/deploy.sh, once, and live in the Kubernetes Secret "wattson".
# One setting per line, NAME=value. A "#" starts a comment. No quotes are needed.
# The scripts READ this file line by line; they never run it.

# ---- where it runs ----------------------------------------------------------------

# The name of the app: every object, the image and the Secret are named after it
# (wattson-orchestrator, wattson-triage, wattson-knowledge). Lower-case letters, digits, "-".
APP_NAME=wattson

# The kubectl context. Every kubectl call of every script names it, so nothing can reach
# another cluster by accident. See: kubectl config get-contexts
K8S_CONTEXT=my-cluster

# The namespace. It must exist already: the scripts never make one. Your other apps
# (Grimoire, Example App, Research Radar) live here too.
K8S_NAMESPACE=grimoire

# Where the image is pushed: host/project. You must be logged in there (docker login).
REGISTRY=registry.example.com/grimoire

# The Secret with the login of the registry, so the cluster can pull the image. The other
# apps of the namespace use this one. Empty: none.
PULL_SECRET=my-pull-secret

# ---- storage ------------------------------------------------------------------------

# The storage class of the three volumes. The cluster has no default class.
STORAGE_CLASS=my-storage-class

# The orchestrator's volume: the task history (SQLite, metadata only).
DATA_SIZE=1Gi

# The knowledge agent's volume: the Grimoire OAuth client and its tokens.
KNOWLEDGE_DATA_SIZE=1Gi

# The volume with the model file. Room for the file twice: a new file is downloaded next to
# the old one before it replaces it.
MODELS_SIZE=3Gi

# ---- Grimoire ----------------------------------------------------------------------

# The MCP address of Grimoire. The knowledge agent reads it, read-only, over HTTPS.
GRIMOIRE_MCP_URL=https://grimoire.example.com/mcp

# ---- the small model (triage) ------------------------------------------------------

# The llama.cpp server for CPU, pinned by digest. "server-b11804" is the build of 22 Oct 2026
# (the same image as the tag "server" on that day). The sidecar runs it, and so does KubeAI's
# llama.cpp engine (k8s/kubeai/values.yaml).
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b11804@sha256:8c74db29f1a2bef3f0a331b52c4d6214601dfceed4bee0b94cc48b3b23ff257d

# The small image that downloads the model before the server starts (it has curl and
# sha256sum), pinned by digest.
FETCH_IMAGE=curlimages/curl:8.23.0@sha256:11e64e28c5f58c8d93ee95fcf22ac055f48b0bc440e0ce7d8013bbb5ad6aa8ac

# The model file: its name on the volume, where it is downloaded from (pinned to one commit
# of the Hugging Face repo), and its SHA-256. A file with another SHA-256 is never used.
# IBM Granite-4.2-3B, Q4_K_M, 2,244,011,552 bytes, Apache-2.0 (ibm-granite/granite-4.2-3b-GGUF).
# Not yet measured here: run eval/run.py against it before keeping it (the 1B had 91.7 % on 72
# requests, docs/decision-model.md). The 8B and the 1B are in the history.
MODEL_FILE=granite-4.2-3b-Q4_K_M.gguf
MODEL_URL=https://huggingface.co/ibm-granite/granite-4.2-3b-GGUF/resolve/c40945d71cd90f249a56985e8155551a9188dc30/granite-4.2-3b-Q4_K_M.gguf
MODEL_SHA256=e0406663965846ae22a403456eb826ccce5f450840491f71952f18a7cb78e7d5

# The context size of the model, in tokens.
LLAMA_CTX=4096

# How many CPU threads the model uses. Keep both at or below the CPU limit of the llama
# container (LLAMA_LIMITS); deploy.sh checks it.
# LLAMA_THREADS: writing the answer, one token at a time. It is limited by memory speed, so
# more threads help little: 4, the cores that are reserved for it (LLAMA_REQUESTS).
LLAMA_THREADS=4
# LLAMA_BATCH_THREADS: reading the prompt, the heavy part of a triage. It uses every core it
# gets: 7, one less than the CPU limit of the KubeAI model pod (8), so the node keeps a core for
# the rest (27 Oct 2026, the user's choice: more CPU for the models; it was 6).
LLAMA_BATCH_THREADS=7

# Below this confidence the triage agent uses its keyword rules instead of the model.
MIN_CONFIDENCE=0.6

# ---- who serves the small model: the sidecar or KubeAI -----------------------------

# sidecar: the llama.cpp server in the triage pod, with the settings above (what ran until
#          23 Oct 2026).
# kubeai:  KubeAI (github.com/kubeai-project/kubeai) serves the model in its own namespace, with
#          its llama.cpp engine: the same image (LLAMA_IMAGE), the same file (MODEL_URL,
#          MODEL_FILE) and the same flags as the sidecar (LLAMA_CTX, LLAMA_THREADS,
#          LLAMA_BATCH_THREADS; see k8s/kubeai/granite-model.yaml). Install it first with:
#          bash k8s/kubeai.sh --apply. Then the triage pod has no llama container, no model
#          download and no model volume.
MODEL_BACKEND=kubeai

# The settings below are used only with MODEL_BACKEND=kubeai (and by k8s/kubeai.sh).
# The namespace of KubeAI: its operator, its proxy and the model pod. kubeai.sh makes it.
KUBEAI_NAMESPACE=kubeai

# The name of the KubeAI Model with Granite (k8s/kubeai/granite-model.yaml). The triage agent
# sends it as the "model" of each request.
KUBEAI_MODEL=granite-4-2-3b

# How many model pods stay up when nobody asks. 0 = no pod and no CPU reserved when idle; the
# first triage after idle waits for the pod to start (a cold start): the pod downloads the
# 0.9 GB model from Hugging Face each time it starts (about a minute), then loads it in 2 s; the
# first time on a node it also pulls the llama.cpp image (LLAMA_IMAGE, once per node). The
# triage pod sends one warm-up triage when it starts: that wakes the model too.
# 1 = always ready, 4 CPU reserved.
KUBEAI_MIN_REPLICAS=0

# How long the model pod stays up after the last request, in seconds: it stays warm during a
# working session. KubeAI looks every 10 s; a triage that falls between two looks may not count.
KUBEAI_SCALE_DOWN_DELAY_SECONDS=3600

# The OpenAI-compatible address of the KubeAI proxy inside the cluster (its Service "kubeai").
KUBEAI_BASE_URL=http://kubeai.kubeai.svc.cluster.local/openai/v1

# ---- the orchestrator ------------------------------------------------------------

# How many days the task history is kept. Older records are removed once a day.
HISTORY_RETENTION_DAYS=90

# A task that nobody answers ends after this many minutes.
TASK_TTL_MINUTES=120

# ---- the Guard (in the orchestrator) ---------------------------------------------

# The Guard checks each request (work, out of scope, risky, malicious), and the evidence and the
# Grimoire documents (prompt injection), before the prompt is made. Your fixed rules first
# (k8s/guard/rules.yaml, k8s/guard/policies.cedar); then, with MODEL_BACKEND=kubeai, the small
# model (the same KubeAI Model as triage), which can only make a verdict stricter.
# enforce: it stops malicious and out-of-scope requests, and asks you before a risky one.
# monitor: it only records its verdict (in the traces and in Grafana); it blocks nothing.
# off:     no checks.
# monitor from 26 Oct 2026 (eval/guard.py: 100 % malicious, 0 % work stopped); enforce since
# 27 Oct 2026. To change it: edit this line, commit, run bash k8s/deploy.sh.
GUARD_MODE=enforce

# How long the Guard waits for the small model, in seconds (1 to 300). Then the rules decide
# alone. When the KubeAI model pod is at 0, its start takes about a minute: the first requests
# after idle get the rules only.
GUARD_TIMEOUT_S=20

# ---- the prompt-injection model (wattson-shield) ---------------------------------

# A small model in its own pod (wattson-shield) reads each evidence item and each section of
# each Grimoire document, after the rules of the Guard (docs/study/guardrails.md). It needs
# GUARD_MODE enforce or monitor; it never blocks a task.
# off:  no model and no shield pod; the evidence rules still cut (what ran until 27 Oct 2026).
# warn: the parts it flags stay in the prompt; the review names them, and Grafana counts them.
# cut:  a part it flags is replaced by "[removed: the injection model flagged this part]".
# warn from 27 Oct 2026; cut since 27 Oct 2026, the same day (the user's choice, D40). Every false
# cut goes into eval/injection.jsonl as a normal case (measure again with eval/injection_model.py).
INJECTION_MODE=cut

# The Hugging Face repo, pinned to one commit, and the three files the shield reads, each with
# its SHA-256: a file with another SHA-256 is never used (like MODEL_URL / MODEL_SHA256 above).
# The init container of the shield pod downloads them at each start (no volume): 302 MB here.
# Horizon-Labs prompt-injection-guard-small, INT8 ONNX, Apache-2.0. Measured at 0.95
# (eval/injection.jsonl, docs/study/guardrails.md): 24 of 25 hard injections caught, 3 of 30 hard
# normal texts flagged, none of the evidence sections of real prompts, 2 of 28 Grimoire runbook
# sections; about 3-8 s a task on 2 CPUs.
INJECTION_MODEL_REPO=Horizon-Labs/prompt-injection-guard-small
INJECTION_MODEL_COMMIT=0e3774536debbcd71dbb8534ef71451b583853b8
INJECTION_MODEL_FILE=onnx/model_quantized.onnx
INJECTION_MODEL_SHA256=61cd0741cdbfcc229e32e1de1392f352736d87d1e8b3c2b67ad9836bb7910d5d
# The tokenizer is pinned too: Horizon's normalizer (zero-width signs, Unicode tags) lives in it.
INJECTION_TOKENIZER_FILE=tokenizer.json
INJECTION_TOKENIZER_SHA256=47834a7dbbb0c4324fe9569fe47955241594a9ee539c9e478755d6fbc51e5f46
# config.json: its id2label holds the label below.
INJECTION_CONFIG_FILE=config.json
INJECTION_CONFIG_SHA256=d6264037c9aa4b3d821c1c9a0329572033adbdb622788ecca91c3636066d9622
# The label of config.json's id2label that means "injection" (any case).
INJECTION_LABEL=INJECTION
# A part is flagged at this probability or more (above 0, at most 1). Measure first:
# eval/injection_model.py.
INJECTION_THRESHOLD=0.95
# Tokens per window: a long part is read in overlapping windows; the highest score counts.
INJECTION_WINDOW=2048
# How long the Guard waits for the shield, in seconds (1 to 300). Then the rules decide alone,
# and the review says so. 300 (27 Oct 2026, the user's choice): long evidence took 35 s on 2 CPUs
# and went past the old 30 s. The CLI waits 900 s for each answer, so it never gives up first.
INJECTION_TIMEOUT_S=300
#
# To use Wolf Defender Small instead (its fp16 file: the only Wolf file that works in plain ONNX
# Runtime; docs/study/guardrails.md, section 3), change these lines:
#   INJECTION_MODEL_REPO=patronus-studio/wolf-defender-prompt-injection-small
#   INJECTION_MODEL_COMMIT=a6b3bb2697cb69cca88f866e45c0f33f1d2793bc
#   INJECTION_MODEL_FILE=onnx/onnx_fp16/model_fp16.onnx
#   INJECTION_MODEL_SHA256=f81eccd747b4fe9b077fb37c7ddbe0571c5b21e544e84fa95cc8bcbff9cd1332
#   INJECTION_TOKENIZER_FILE=onnx/onnx_fp16/tokenizer.json
#   INJECTION_TOKENIZER_SHA256=7e426c3929b44e6ab4c931770b5f22b913280633f5a1c67c81e9ad64decef55c
#   INJECTION_CONFIG_FILE=config.json
#   INJECTION_CONFIG_SHA256=b5bfba7b100b4b1aa361e8160e5593695164d81ca09b47f3b26561332b520218
#   INJECTION_LABEL=injection
#   INJECTION_THRESHOLD=0.9
# then commit and run bash k8s/deploy.sh: only the shield pod starts again, with the new files.

# ---- the traces (OpenTelemetry) and Grafana --------------------------------------

# on:  the three agents send a trace of each task (OTLP over HTTP, contents redacted) to Tempo,
#      a trace store next to them (Deployment wattson-tempo, its own volume). Grafana reads it;
#      k8s/grafana.sh adds the data source and the dashboard "Wattson Agent" to your Grafana.
# off: no Tempo, and the agents get no address to send traces to.
TELEMETRY=on

# Grafana Tempo, one process (it receives, keeps and answers queries), pinned by digest.
# 3.1.1 is the release of 21 Oct 2026. Tempo 3 answers TraceQL metrics (counts, averages,
# p50/p95 of durations) from the traces themselves: no Prometheus is needed.
TEMPO_IMAGE=grafana/tempo:3.1.1@sha256:64e2fbd56d9c2b3412a4b430a58ea59e91a670b1e75f920a0c702213ad145044

# The volume of Tempo: the traces. A task makes a few kilobytes.
TEMPO_SIZE=5Gi

# How long Tempo keeps the traces, in hours (336h = 14 days). Grafana may ask about all of it.
TEMPO_RETENTION=336h

# The Grafana that shows the traces: its namespace and its Service (its Deployment has the same
# name, as the Grafana Helm chart makes it). It is not ours: k8s/grafana.sh only uses Grafana's
# own HTTP API, and the network rule of Tempo lets this namespace ask Tempo (port 3200).
# NOTE: a Grafana that anyone can reach must keep its login strong; the traces show your tasks.
# the traces of wattson (their contents are redacted by the agents).
GRAFANA_NAMESPACE=monitoring
GRAFANA_SERVICE=monitoring-grafana

# ---- the network -------------------------------------------------------------------

# The address of the node-local DNS cache (this cluster runs nodelocaldns: pods ask
# 169.254.25.10). The network rules let the pods ask it, and CoreDNS. Empty: CoreDNS only.
NODE_LOCAL_DNS=169.254.25.10

# ---- CPU and memory per container: "cpu/memory" ------------------------------------
# A request is what the cluster keeps free for the container; a limit is the most it gets.

# The orchestrator (Python, Strands, the task history). Measured: the Python agents take
# about 125 MiB after start-up (imports of Strands and A2A), before any work.
ORCHESTRATOR_REQUESTS=50m/192Mi
ORCHESTRATOR_LIMITS=1000m/512Mi

# The triage agent (Python, Strands; the model runs in the llama container next to it).
TRIAGE_REQUESTS=50m/192Mi
TRIAGE_LIMITS=500m/384Mi

# The knowledge agent (Python, Strands, the MCP client of Grimoire).
KNOWLEDGE_REQUESTS=50m/192Mi
KNOWLEDGE_LIMITS=500m/384Mi

# The llama.cpp server with the model. Measured with Granite: about 1.0 GiB loaded, 1.5 GiB
# at peak (two requests at once). The CPU limit must allow LLAMA_THREADS. With KubeAI the
# model pod gets the same, from the resource profile in k8s/kubeai/values.yaml.
# 4 cores reserved, up to 8 (the user's choices, 22 and 27 Oct 2026). Note: a 4-core request fits
# only a node with 4 cores not yet reserved; on 22 Oct 2026 only node1 had that (2.7-3.7 on the
# workers). If the triage pod stays Pending, lower the request to 3000m.
LLAMA_REQUESTS=4000m/1536Mi
LLAMA_LIMITS=8000m/2Gi

# The download of the model (only at pod start; it does nothing when the file is good).
FETCH_REQUESTS=50m/32Mi
FETCH_LIMITS=500m/128Mi

# The shield (INJECTION_MODE warn or cut). Measured in Docker with Horizon small (27 Oct 2026):
# 0.47 GiB after load, 0.66 GiB after five 4000-character parts (5.4 s on 2 CPUs). Its CPU
# limit is also the number of threads of one inference (whole cores, at least 1).
# On the cluster, 6 long evidence parts took 35 s on 2 CPUs (27 Oct 2026). Since then (the
# user's choice): 1 CPU reserved, up to 6, so 6 threads; 2 GiB at most for the extra threads.
SHIELD_REQUESTS=1000m/768Mi
SHIELD_LIMITS=6000m/2Gi

# Tempo (TELEMETRY=on). Measured in Docker with the config of k8s/wattson.yaml (23 Oct 2026):
# ready in 2 s, 36-110 MiB with about a hundred traces.
TEMPO_REQUESTS=50m/256Mi
TEMPO_LIMITS=200m/512Mi

# ---- Cognee: the memory for Claude Code, and its web UI (k8s/cognee.sh, docs/cognee.md) --------
# deploy.sh does not read these. The volume and the Service use the storage class and the
# namespace above; the pod is named <APP_NAME>-cognee. One pod, three containers: the API server
# (the only one that opens the stores), cognee-mcp in API mode, and the web UI.
#
# The volume of the memory (SQLite, LanceDB, Ladybug, the notes, the users). Kept by --delete.
COGNEE_SIZE=10Gi

# CPU and memory of the API server (the container "api"): it does the work and loads the models.
# FIRST GUESSES, not measured yet (28 Oct 2026): GLiNER (the graph, about 0.8 GB in memory, more
# while it reads) and fastembed (0.1 GB) load at the first remember. Tune them after the first
# runs: bash k8s/cognee.sh --smoke, then --top.
# The CPU limit is also the number of threads of torch (whole cores, at least 1).
# 28 Oct 2026: 5Gi was OOM-killed (exit 137) during GLiNER inference on the first session upload;
# raised to 8Gi (nodes have about 23 GB allocatable each).
COGNEE_REQUESTS=500m/1536Mi
COGNEE_LIMITS=4000m/8Gi

# CPU and memory of cognee-mcp in API mode (the container "mcp"): it only passes the calls on, but
# it loads the cognee package (no model). FIRST GUESSES.
COGNEE_MCP_REQUESTS=50m/512Mi
COGNEE_MCP_LIMITS=1000m/1536Mi

# CPU and memory of the web UI (the container "ui", a Next.js server). FIRST GUESSES.
COGNEE_UI_REQUESTS=20m/128Mi
COGNEE_UI_LIMITS=500m/512Mi

# The ports on this laptop for --port-forward and --smoke, three different ones:
#   MCP for Claude Code:  http://127.0.0.1:<COGNEE_LOCAL_PORT>/mcp
#   the API server:       http://127.0.0.1:<COGNEE_API_LOCAL_PORT> (the pages of the UI call it)
#   the web UI:           http://127.0.0.1:<COGNEE_UI_LOCAL_PORT> (open this one in the browser)
# The API server listens on the same port number inside the pod (the UI's server calls it at the
# address the browser uses): a change of COGNEE_API_LOCAL_PORT or COGNEE_UI_LOCAL_PORT needs
# --apply again.
COGNEE_LOCAL_PORT=8765
COGNEE_API_LOCAL_PORT=8766
COGNEE_UI_LOCAL_PORT=8767

# ---- "Seen before": the knowledge agent reads Cognee's lessons (docs/cognee.md, D47) ----------
# deploy.sh reads these. With "on", after Grimoire the knowledge agent asks the pod
# <APP_NAME>-cognee above (the MCP tool "recall" only, read-only) for past lessons that fit the
# question, and the answer gets a short part "Seen before". If Cognee is slow, down or has
# nothing, the answer is the same as with "off". "off" turns it off (then deploy.sh again).
COGNEE_RECALL=on

# The MCP address of that pod, as the knowledge agent sees it. Empty is the pod's Service,
# http://<APP_NAME>-cognee:8000/mcp (here http://wattson-cognee:8000/mcp); another value must name
# that Service too: the agent's network rule lets it reach only that pod and port.
COGNEE_RECALL_URL=

# The dataset of the lessons: the one the Claude Code skill save-lessons writes to.
COGNEE_RECALL_DATASET=claude_code_memory

# At most this many lessons in the answer (1 to 3), and how long the agent waits for Cognee,
# in whole seconds (1 to 10): after that it answers without lessons.
COGNEE_RECALL_LESSONS=3
COGNEE_RECALL_TIMEOUT_S=5
