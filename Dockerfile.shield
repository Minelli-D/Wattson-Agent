# The image of wattson-shield, the small prompt-injection model (docs/study/guardrails.md).
# It holds Python, the packages of the "shield" group of uv.lock (onnxruntime, tokenizers,
# numpy, Starlette, uvicorn), and one file: src/wattson/shield/server.py. Not wattson, not the
# agents' packages, not the model: the init container of the pod downloads the model files and
# checks their SHA-256. It runs as user 10001 and writes nothing (the root is read-only).
#
#   docker build --platform linux/amd64 -f Dockerfile.shield -t wattson-shield .   (k8s/deploy.sh does this)

# The same pinned images as the Dockerfile of the agents.
ARG PYTHON_IMAGE=python:3.13-slim@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff

FROM ${UV_IMAGE} AS uv

# ---- build: only the "shield" group of uv.lock, exactly, into /app/.venv ------------------
FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.13 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_NO_CACHE=1
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group shield --no-install-project --no-editable

# ---- the image that runs ------------------------------------------------------------
FROM ${PYTHON_IMAGE}
RUN rm -rf /usr/local/lib/python3.13/site-packages/pip /usr/local/lib/python3.13/site-packages/pip-* \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.13
COPY --from=build /app/.venv /app/.venv
COPY src/wattson/shield/server.py /app/shield.py
ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TMPDIR=/tmp
WORKDIR /tmp
USER 10001:10001
CMD ["python", "-I", "/app/shield.py"]
