#!/usr/bin/env python3
"""A stand-in for the `claude` CLI, for the CLI tests only. It writes a session file like Claude Code
does, logs what it got (FAKE_CLAUDE_LOG), and prints a `-p --output-format json` result."""

import json
import os
import re
import sys
import uuid
from datetime import UTC, datetime

args = sys.argv[1:]
headless = "-p" in args
session_id = None
if "--session-id" in args:
    session_id = args[args.index("--session-id") + 1]
if "--resume" in args:
    session_id = args[args.index("--resume") + 1]
if "--fork-session" in args:
    session_id = str(uuid.uuid4())
prompt = sys.stdin.read() if headless else args[-1]

log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"args": args, "prompt": prompt, "cwd": os.getcwd()}) + "\n")

mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
reply = os.environ.get("FAKE_CLAUDE_REPLY", "The api container runs out of memory. Raise the limit to 512Mi.")
folder = os.path.join(os.environ["WATTSON_CLAUDE_HOME"], "projects", re.sub(r"[^A-Za-z0-9]", "-", os.getcwd()))
os.makedirs(folder, exist_ok=True)
now = datetime.now(UTC).isoformat()
with open(os.path.join(folder, f"{session_id}.jsonl"), "a", encoding="utf-8") as fh:
    fh.write(json.dumps({"type": "user", "timestamp": now, "message": {"role": "user", "content": prompt}}) + "\n")
    if mode == "ok":
        text = {"type": "text", "text": reply}
        msg = {"id": f"m-{uuid.uuid4().hex[:8]}", "role": "assistant", "content": [text]}
        fh.write(json.dumps({"type": "assistant", "timestamp": now, "message": msg}) + "\n")

if mode == "fail":
    if headless:
        print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True,
                          "result": "the model is overloaded", "session_id": session_id}))
    sys.exit(1)
if headless:
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": reply,
                      "session_id": session_id}))
sys.exit(0)
