#!/usr/bin/env python3
"""A stand-in for `kubectl`, for the CLI tests only. Logs its arguments (FAKE_KUBECTL_LOG)."""

import json
import os
import sys
import time

args = sys.argv[1:]
log = os.environ.get("FAKE_KUBECTL_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(args) + "\n")

if args[:2] == ["config", "get-contexts"]:
    print("my-cluster\nother-ctx")
    sys.exit(0)
if args[:2] == ["config", "current-context"]:
    print("my-cluster")
    sys.exit(0)
if "port-forward" in args:
    mode = os.environ.get("FAKE_KUBECTL_PF", "ok")
    if mode == "fail":
        print('error: deployments.apps "wattson-orchestrator" not found', file=sys.stderr, flush=True)
        sys.exit(1)
    if mode == "hang":
        time.sleep(30)
        sys.exit(0)
    port = os.environ.get("FAKE_KUBECTL_PORT", "45678")
    print(f"Forwarding from 127.0.0.1:{port} -> 9000", flush=True)
    print(f"Forwarding from [::1]:{port} -> 9000", flush=True)
    time.sleep(30)
    sys.exit(0)
if "namespaces" in args and "--ignore-not-found" in args:
    # Every namespace exists but those in FAKE_KUBECTL_MISSING_NS (comma separated).
    gone = set(os.environ.get("FAKE_KUBECTL_MISSING_NS", "").split(","))
    start = args.index("namespaces") + 1
    for name in args[start:]:
        if name.startswith("-"):
            break
        if name not in gone:
            print(f"namespace/{name}")
    sys.exit(0)
if "get" in args:
    print("NAME        READY   STATUS             RESTARTS   AGE")
    print("api-7d9f4   0/1     CrashLoopBackOff   12         1h")
    sys.exit(0)
print("ok")
