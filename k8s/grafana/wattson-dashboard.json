    },
    {
      "type": "piechart",
      "title": "Who decided the kind of task",
      "description": "How triage decided what kind of task a request is: the small model (sure enough), the keyword rules (the model was not sure, or down), or you (you chose it yourself).",
      "datasource": {
        "type": "tempo",
        "uid": "wattson-tempo"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "wattson-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"wattson.task.end\"} | count_over_time() by (span.wattson.triage.method)",
          "metricsQueryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{span\\.wattson\\.triage\\.method=\"(.*)\"\\}$",
            "renamePattern": "$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^model$",
            "renamePattern": "the model"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rules$",
            "renamePattern": "keyword rules"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^override$",
            "renamePattern": "you"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "__systemRef": "hideSeriesFrom",
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "exclude",
                "names": [
                  "the model",
                  "you",
                  "keyword rules"
                ],
                "prefix": "All except:",
                "readOnly": true
              }
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 3
    },
    {
      "type": "bargauge",
      "title": "Triage confidence: average and lowest",
      "description": "The confidence of triage in its answer, by who decided: the model's own probability, as a whole percent (span.wattson.triage.confidence_pct). Below the setting MIN_CONFIDENCE (60 %) the keyword rules decide. Average and lowest, not p50/p95: Tempo computes quantiles from power-of-two buckets, and every value from 65 % to 100 % falls into one of them, so a p95 would read up to 128 %.",
      "datasource": {
        "type": "tempo",
        "uid": "wattson-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "wattson-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"wattson.task.end\"} | avg_over_time(span.wattson.triage.confidence_pct) by (span.wattson.triage.method)",
          "metricsQueryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "wattson-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"wattson.task.end\"} | min_over_time(span.wattson.triage.confidence_pct) by (span.wattson.triage.method, name)",
          "metricsQueryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{name=\"wattson\\.task\\.end\", span\\.wattson\\.triage\\.method=\"(.*)\"\\}$",
            "renamePattern": "$1 lowest"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{span\\.wattson\\.triage\\.method=\"(.*)\"\\}$",
            "renamePattern": "$1 average"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^([^{} ]+)$",
            "renamePattern": "$1 average"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^model (average|lowest)$",
            "renamePattern": "the model $1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rules (average|lowest)$",
            "renamePattern": "keyword rules $1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^override (average|lowest)$",
            "renamePattern": "you $1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* lowest$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 300,
        "text": {
          "titleSize": 13,
          "valueSize": 15
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
