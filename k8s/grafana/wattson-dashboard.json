    {
      "type": "bargauge",
      "title": "How long the model takes (p50 and p95)",
      "description": "The time of each call to the small model in the triage pod: classify (the kind of task and how sure) and hints (names and search words). Half of the calls took less than p50, 95 in 100 less than p95.",
      "datasource": {
